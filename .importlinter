# Architecture contracts, enforced by import-linter.
#
# These are not documentation: tests/architecture/test_layer_boundaries.py runs
# every contract below as part of the normal pytest suite, and `make arch`, the
# pre-commit hook and CI run the `lint-imports` console script over the same file.
# A violation is a failing build, not a review comment.
#
# `include_external_packages = True` is required for the two `forbidden` contracts:
# without it import-linter never builds nodes for third-party distributions and the
# contracts silently have nothing to check.

[importlinter]
root_package = taskmanager
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture (high to low)
type = layers
layers =
    taskmanager.main
    taskmanager.presentation
    taskmanager.infrastructure
    taskmanager.application
    taskmanager.domain

# The domain is stdlib-only: entities are dataclasses, ports are typing.Protocol.
# pydantic is forbidden here on purpose - a pydantic ValidationError cannot carry
# the domain error contract, so validation belongs at the boundaries, not inside.
[importlinter:contract:domain-framework-free]
name = Domain is framework-free
type = forbidden
source_modules =
    taskmanager.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    pydantic
    pydantic_settings
    jwt
    pwdlib
    httpx

# The application layer orchestrates use cases through ports. pydantic is left out
# of the list below deliberately: the contract is not tightened, because a later
# phase may have a legitimate reason for a Pydantic DTO. ADR-020 chooses frozen
# dataclasses for command and result DTOs, so nothing in this layer imports pydantic
# today - that is a convention, stated once in application/dto/commands.py, not a
# rule enforced here. What is enforced: the layer must never see the web framework
# or the ORM.
[importlinter:contract:application-framework-free]
name = Application knows no web framework or ORM
type = forbidden
source_modules =
    taskmanager.application
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    alembic
    jwt
    pwdlib

# D-15: HTTP is the presentation layer's vocabulary and nobody else's. The rule it
# exists to keep is that `fastapi.HTTPException` is never raised below presentation -
# a business layer that raises it has built an error body by hand, bypassing the single
# RFC 9457 handler ARC-07 puts in charge of every response.
#
# What is deliberately OUT of source_modules: `presentation`, which is the layer that
# is *supposed* to import FastAPI, and `main`, which composes it. Naming either would
# forbid the application from having a web interface at all.
#
# What is deliberately in forbidden_modules: the two packages, not the `HTTPException`
# symbol. An import-linter `forbidden` contract works on modules, so it cannot express
# "this name in particular" - it answers the broader question instead, and answers it
# for the whole subtree. The symbol-level question is a different gate's:
# `tests/architecture/test_routers_raise_no_http_exception.py` (plan 04-08) walks the
# AST of every module under `presentation/api` except `errors/handlers.py`, the one
# exception-handling point, and refuses both the `raise` and any import of the class.
# (Until the Phase 4 review's WR-05 this comment claimed "the presentation layer" while
# the test scanned `routers/` only; the test was widened to match, not the claim
# narrowed.) The two are complementary rather than redundant.
#
# `domain` and `application` are already covered by their own contracts above; they are
# repeated here so that this contract states D-15 completely and a future narrowing of
# either one cannot silently open a hole in it. `infrastructure` is the layer this adds:
# it is clean today, its only occurrence of `starlette` being a prose mention inside
# `db/engine.py`'s docstring, which import-linter does not see.
#
# No pre-commit hook and no CI step is added for this. Both already run `lint-imports`
# over this file - the hook id `import-linter` and the CI step "Architecture contracts" -
# so ADR-015's rule that a new gate goes in both places does not apply to a contract that
# rides inside a command both already invoke. The same argument plans 02-06 and 03-06
# recorded for their own additions.
[importlinter:contract:no-http-below-presentation]
name = No web framework below presentation
type = forbidden
source_modules =
    taskmanager.domain
    taskmanager.application
    taskmanager.infrastructure
forbidden_modules =
    fastapi
    starlette
