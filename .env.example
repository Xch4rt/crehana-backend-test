# Example environment file for the Task Manager API.
#
# Copy it to .env and replace every placeholder before running the application:
#   cp .env.example .env
#
# Every key below maps one-to-one to a field of
# taskmanager.infrastructure.config.settings.Settings, and a unit test enforces
# that parity. .env itself is git-ignored and never enters a Docker build
# context; the values here are non-secret placeholders only.

# Human-readable application name, shown as the OpenAPI document title.
APP_NAME=Task Manager API

# Deployment environment label: local, ci, staging or production.
ENVIRONMENT=local

# PostgreSQL DSN used by SQLAlchemy through the psycopg 3 driver.
# Declared from the start so CI can export it; first consumed in Phase 3.
DATABASE_URL=postgresql+psycopg://taskmanager:taskmanager@localhost:5432/taskmanager

# Secret used to sign JWT access tokens. Minimum 16 characters, no default.
# FAKE PLACEHOLDER - generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me-with-a-generated-secret

# Signing algorithm for JWT access tokens.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes. Must be greater than zero.
JWT_EXPIRE_MINUTES=30
