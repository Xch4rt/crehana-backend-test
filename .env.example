# Example environment file for the Task Manager API.
#
# Copy it to .env and replace every placeholder before running the application:
#   cp .env.example .env
#
# Every key below maps one-to-one to a field of
# taskmanager.infrastructure.config.settings.Settings, and a unit test enforces
# that parity. .env itself is git-ignored and never enters a Docker build
# context; the values here are non-secret placeholders only.

# Human-readable application name, shown as the OpenAPI document title.
APP_NAME=Task Manager API

# Deployment environment label: local, ci, staging or production.
ENVIRONMENT=local

# PostgreSQL DSN used by SQLAlchemy through the psycopg 3 driver.
#
# The host below is the one to use from your own machine - `make test`, `make run`
# and any `alembic` command run from the host all reach the compose database
# through localhost, on the published port 5432.
#
# Inside the compose network the host is instead the service name `db`:
#   # DATABASE_URL=postgresql+psycopg://taskmanager:taskmanager@db:5432/taskmanager
# That line stays commented on purpose. The `api` service overrides DATABASE_URL
# for the compose network in docker-compose.yml, so your .env can stay on
# localhost and never needs editing between the two paths. Uncommenting it would
# not break the .env.example/Settings parity test - that test ignores comments
# and collects key names, not values - but pydantic reads the *last* assignment,
# so a second live line would silently change which host the application dials.
DATABASE_URL=postgresql+psycopg://taskmanager:taskmanager@localhost:5432/taskmanager

# Test database DSN, read by tests/integration/conftest.py only. When it is unset
# the URL is derived from DATABASE_URL by swapping the database name for
# taskmanager_test, which is the database the compose init script creates
# alongside the application one - so most developers never need to set this.
TEST_DATABASE_URL=postgresql+psycopg://taskmanager:taskmanager@localhost:5432/taskmanager_test

# Secret used to sign JWT access tokens. Minimum 16 characters, no default.
# FAKE PLACEHOLDER - generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me-with-a-generated-secret

# Signing algorithm for JWT access tokens.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes. Must be greater than zero.
JWT_EXPIRE_MINUTES=30
